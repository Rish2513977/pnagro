rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == '2k25cse2513977@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Equipment collection
    match /equipment/{equipmentId} {
      allow read: if true; // Public catalog for farmers to search machinery
      allow create: if isSignedIn() && isValidId(equipmentId) &&
        incoming().ownerId == request.auth.uid &&
        incoming().title is string && incoming().title.size() <= 100 &&
        incoming().hourlyRate is number && incoming().hourlyRate > 0;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId)
      );
      allow delete: if isSignedIn() && (
        isAdmin() ||
        existing().ownerId == request.auth.uid
      );
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.renterId == request.auth.uid
      );
      allow create: if isSignedIn() && isValidId(bookingId) &&
        incoming().renterId == request.auth.uid &&
        incoming().totalAmount is number && incoming().totalAmount > 0;
      allow update: if isSignedIn() && (
        isAdmin() ||
        existing().renterId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(reviewId) &&
        incoming().userId == request.auth.uid &&
        incoming().rating is number && incoming().rating >= 1 && incoming().rating <= 5;
      allow update, delete: if isSignedIn() && (
        isAdmin() ||
        existing().userId == request.auth.uid
      );
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == userId
      );
      allow create, update: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == userId
      );
      allow delete: if isAdmin();
    }
  }
}
